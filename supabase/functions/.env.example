# Server-side only. Copy to an ignored .env.local for local Edge development.
# Production: enter these values in Supabase Edge Functions → Secrets.
# Never use a VITE_ prefix for these values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional; production uses the original website origin by default.
# In an isolated local Supabase project only:
# COMMUNICATIONS_APP_ORIGIN=http://127.0.0.1:5180
